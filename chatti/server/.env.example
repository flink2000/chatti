# Copy to .env and adjust. .env is gitignored - it holds machine-specific paths.

# Where the server keeps its runtime state: .config.yaml, chatti-prompt.txt,
# conversations/, recordings. Leave this commented out and it lands in ./data
# next to docker-compose.yml, which is what a fresh install should do.
#
# Set it only if that directory already exists somewhere else. Use forward
# slashes even on Windows.
#
#CHATTI_DATA=D:/chatti/server/main/xiaozhi-server/data
